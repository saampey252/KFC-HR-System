rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Employees Collection - KFC personnel records
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Operational Departments
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // Job Positions and Designations
    match /job_positions/{positionId} {
      allow read, write: if true;
    }

    // Attendance and Leaves
    match /leaves/{leaveId} {
      allow read, write: if true;
    }

    // Compliance and HR Documents
    match /hr_documents/{docId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // HR System Settings
    match /hr_settings/{settingId} {
      allow read, write: if true;
    }

    // Admins and Test Connection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
